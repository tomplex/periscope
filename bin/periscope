#!/bin/sh
# Helper for managing the launchd-managed periscope service. See
# docs/superpowers/specs/2026-05-15-periscope-stability-design.md.
#
# `install` generates the launchd plist from the current checkout — the
# repo path and the `uv` location are resolved at install time, so
# periscope can be cloned anywhere and installed by anyone.

REPO="$(cd "$(dirname "$0")/.." && pwd)"
PLIST_DST="$HOME/Library/LaunchAgents/com.tom.periscope.plist"
LABEL="gui/$(id -u)/com.tom.periscope"
CONFIG_DIR="$HOME/.config/periscope"
LOG="$CONFIG_DIR/periscope-8765.log"

# Everything is wrapped in main() so `sh` parses the WHOLE file before running
# any of it. `update` rewrites this very script mid-execution via git pull; an
# unwrapped script leaves sh resuming at a byte offset into a file that has
# since changed length.
main() {

# Regenerate the launchd plist from the current checkout. Requires $UV (see
# require_uv, which every caller runs as a precondition). Shared by `install`
# and `update`: the plist embeds repo/uv paths AND tunables that change over
# time (NumberOfFiles was raised 256->1024 after a silent EMFILE wedge), so an
# update that only pulls code leaves those fixes unapplied. launchd caches the
# loaded plist — a rewrite only takes effect after bootout+bootstrap, NOT
# `kickstart -k`, which restarts the job against the already-loaded config.
require_uv() {
  UV="$(command -v uv)" || {
    echo "uv not found on PATH — install it: https://docs.astral.sh/uv/" >&2
    return 1
  }
}

write_plist() {
    mkdir -p "$CONFIG_DIR"
    cat > "$PLIST_DST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tom.periscope</string>
  <key>WorkingDirectory</key>
  <string>$REPO</string>
  <key>ProgramArguments</key>
  <array>
    <string>$UV</string>
    <string>run</string>
    <string>server.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(dirname "$UV"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>$HOME</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- launchd's default RLIMIT_NOFILE is 256. EMFILE here doesn't crash the
       process (KeepAlive can't recycle it) — it wedges, 500ing forever. Give
       headroom well above legit usage (~1 fd/pane); the worker tick warns long
       before this if fds actually run away. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1024</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$CONFIG_DIR/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$CONFIG_DIR/launchd-stderr.log</string>
</dict>
</plist>
EOF
}

case "$1" in
  install)
    command -v npm >/dev/null 2>&1 || {
      echo "npm not found on PATH — install Node.js: https://nodejs.org/" >&2
      exit 1
    }
    # The frontend is a committed Vite bundle (static/dist/app.js). Build it
    # at install time so the launchd-managed server has a fresh artifact.
    ( cd "$REPO" && npm install && npm run build ) || {
      echo "npm install && npm run build failed" >&2
      exit 1
    }
    require_uv || exit 1
    write_plist || exit 1
    launchctl bootstrap "gui/$(id -u)" "$PLIST_DST"
    "$0" install-hook
    ;;
  update)
    # Pull + re-provision + restart. Ordering is the safety property: the git
    # pull happens BEFORE anything touches launchd, so the common failures
    # (dirty tree, diverged branch) abort with the running server completely
    # untouched — and, when driven from POST /api/update, still alive to serve
    # the error back to the dashboard.
    #
    # Deliberately does NOT run `npm run build`: static/dist/app.js is
    # committed, so the pull already carries it, and a build against drifted
    # node_modules can emit a different bundle — dirtying the tree and breaking
    # the NEXT `git pull --ff-only`.
    # `uv` is a precondition of write_plist, so resolve it BEFORE the pull. A
    # pull that lands and then aborts at write_plist leaves the new committed
    # bundle (served per-request from disk) talking to the old Python — a
    # silent, permanent version skew.
    require_uv || exit 1
    # Refuse from a linked worktree. $REPO comes from dirname "$0", so running
    # this from .claude/worktrees/foo would pull the FEATURE branch and then
    # write WorkingDirectory=<worktree> into the PROD plist — leaving prod
    # pointing at a directory that ExitWorktree later deletes.
    if [ "$(git -C "$REPO" rev-parse --git-dir)" != "$(git -C "$REPO" rev-parse --git-common-dir)" ]; then
      echo "refusing: $REPO is a linked worktree — update the main checkout instead" >&2
      exit 1
    fi
    # Never block on a credential or host-key prompt: under launchd there is no
    # tty to answer one, and a wedged `git pull` would pin updater.running()
    # true forever, 409ing every later attempt until the server restarts.
    GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"; export GIT_SSH_COMMAND
    OLD="$(git -C "$REPO" rev-parse --short HEAD)"
    # Refresh first: a stale index makes diff-index report phantom modifications
    # from mtime churn alone.
    git -C "$REPO" update-index -q --refresh
    git -C "$REPO" diff-index --quiet HEAD -- || {
      echo "working tree is dirty — commit or stash before updating" >&2
      exit 1
    }
    git -C "$REPO" pull --ff-only || {
      echo "git pull --ff-only failed — the checkout has diverged from origin" >&2
      exit 1
    }
    NEW="$(git -C "$REPO" rev-parse --short HEAD)"
    write_plist || exit 1
    # Validate before booting out: a malformed plist is the one realistic way
    # bootstrap fails, and past this line a failure means nothing is running.
    plutil -lint "$PLIST_DST" >/dev/null 2>&1 || {
      echo "generated plist is malformed — refusing to restart" >&2
      exit 1
    }
    # bootout is ASYNCHRONOUS and periscope has twice lingered in teardown (once
    # 20s, once 3+ min — see CLAUDE.md > Development workflow). Bootstrapping
    # into a half-torn-down job fails, and by then we are already booted out
    # with KeepAlive unable to help: the dashboard is gone, so nothing can even
    # report the failure. Wait for the job to actually leave, then retry.
    launchctl bootout "$LABEL" 2>/dev/null
    i=0
    while [ "$i" -lt 60 ]; do
      launchctl print "$LABEL" >/dev/null 2>&1 || break
      i=$((i + 1))
      sleep 1
    done
    i=0
    until launchctl bootstrap "gui/$(id -u)" "$PLIST_DST" 2>/dev/null; do
      i=$((i + 1))
      if [ "$i" -ge 15 ]; then
        echo "launchctl bootstrap failed after $i tries — periscope is NOT running." >&2
        echo "recover with: $0 start" >&2
        exit 1
      fi
      sleep 2
    done
    "$0" install-hook
    # Verify the new code is actually serving rather than claiming success:
    # poll healthz until it reports the SHA we just pulled. Generous, because
    # a pull that changed server.py's PEP-723 header makes `uv run` resolve and
    # download dependencies before the port ever opens.
    i=0
    while [ "$i" -lt 180 ]; do
      SERVING="$(curl -fsS "http://127.0.0.1:8765/api/healthz" 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null)"
      if [ "$SERVING" = "$NEW" ]; then
        echo "updated $OLD -> $NEW"
        exit 0
      fi
      # healthz reports 'unknown' when git isn't on the launchd PATH. The SHA
      # can then never match, so waiting out the full timeout would report a
      # failure for an update that actually landed.
      if [ "$SERVING" = "unknown" ]; then
        echo "updated $OLD -> $NEW (serving, but healthz can't read its own SHA)"
        exit 0
      fi
      i=$((i + 1))
      sleep 1
    done
    echo "timed out waiting for periscope to serve $NEW (last saw '$SERVING')" >&2
    exit 1
    ;;
  uninstall)
    launchctl bootout "$LABEL" 2>/dev/null
    rm -f "$PLIST_DST"
    "$0" uninstall-hook
    ;;
  install-hook)
    "$0" install-claude-hook
    "$0" install-codex-hook
    ;;
  install-claude-hook)
    # Register pane_session_hook.py on Claude's SessionStart + UserPromptSubmit
    # hooks so each pane records its CURRENT session id (periscope.turns maps
    # pane -> session). SessionStart fires at startup AND on /clear (immediate,
    # before the first prompt — a fresh pane shows its OWN transcript at once);
    # UserPromptSubmit catches every prompt (migrates pre-hook panes on next
    # message). Idempotent merge — joins existing hook groups, preserves
    # everything else.
    #
    # Runs for EVERY account config dir, not just ~/.claude. Claude reads hooks
    # from whichever CLAUDE_CONFIG_DIR it was launched under, so a second-account
    # pane whose settings.json lacks these writes no pane_sessions row — and the
    # transcript view, the narrator (which has no cwd fallback by design),
    # per-pane burn, and resurrect's --resume rewrite all go dark for it, with no
    # error anywhere. Dirs are kept in step with store.py's _DEFAULT_ACCOUNTS;
    # ones that don't exist on this machine are skipped.
    python3 - "$REPO" \
      "$HOME/.claude/settings.json" \
      "$HOME/.claude-b/settings.json" <<'PY'
import json, os, sys
repo = sys.argv[1]
cmd = f"python3 {repo}/pane_session_hook.py"
for p in sys.argv[2:]:
    if not os.path.isdir(os.path.dirname(p)):
        continue          # that account isn't set up on this machine
    try:
        with open(p) as f: d = json.load(f)
    except FileNotFoundError:
        d = {}
    hooks = d.setdefault("hooks", {})
    added = []
    for ev in ("SessionStart", "UserPromptSubmit"):
        groups = hooks.setdefault(ev, [])
        if any(h.get("command", "").endswith("pane_session_hook.py")
               for g in groups for h in g.get("hooks", [])):
            continue
        entry = {"type": "command", "command": cmd, "timeout": 5}
        if groups:
            groups[0].setdefault("hooks", []).append(entry)   # join an existing group
        else:
            groups.append({"matcher": "", "hooks": [entry]})
        added.append(ev)
    if added:
        with open(p, "w") as f: json.dump(d, f, indent=2)
        print(f"installed pane-session hook in {p} on: {', '.join(added)}")
    else:
        print(f"pane-session hook already installed in {p}")
PY
    ;;
  install-codex-hook)
    ( cd "$REPO" && exec python3 -m periscope.codex_hook_config install "$REPO" )
    ;;
  uninstall-hook)
    "$0" uninstall-claude-hook
    "$0" uninstall-codex-hook
    ;;
  uninstall-claude-hook)
    # Mirrors install-claude-hook: every account config dir, not just ~/.claude,
    # or uninstall leaves the second account's panes still firing the hook.
    python3 - "$HOME/.claude/settings.json" \
             "$HOME/.claude-b/settings.json" <<'PY'
import json, os, sys
for p in sys.argv[1:]:
    try:
        with open(p) as f: d = json.load(f)
    except FileNotFoundError:
        continue
    h = d.get("hooks", {})
    for ev in ("SessionStart", "UserPromptSubmit"):
        groups = h.get(ev, [])
        for g in groups:
            g["hooks"] = [x for x in g.get("hooks", []) if not x.get("command", "").endswith("pane_session_hook.py")]
        groups = [g for g in groups if g.get("hooks")]
        if groups:
            h[ev] = groups
        else:
            h.pop(ev, None)
    with open(p, "w") as f: json.dump(d, f, indent=2)
    print(f"removed pane-session hook from {p}")
PY
    ;;
  uninstall-codex-hook)
    ( cd "$REPO" && exec python3 -m periscope.codex_hook_config uninstall "$REPO" )
    ;;
  resurrect-rewrite)
    # tmux-resurrect post-save-layout hook (save.sh passes the save-file path).
    # Rewrites claude pane commands to `claude --resume <uuid> <channels>` so a
    # reboot restores each pane's specific session instead of a fresh one. Run
    # from the checkout so `periscope` is importable (tmux fires hooks from an
    # arbitrary cwd); stdlib-only, so plain python3 with no uv/venv.
    ( cd "$REPO" && exec python3 -m periscope.resurrect "$2" )
    ;;
  start)
    launchctl bootstrap "gui/$(id -u)" "$PLIST_DST"
    ;;
  stop)
    launchctl bootout "$LABEL"
    ;;
  restart)
    launchctl kickstart -k "$LABEL"
    ;;
  status)
    launchctl print "$LABEL" 2>/dev/null | grep -E 'state|pid' || echo "not loaded"
    ;;
  tail)
    tail -F "$LOG"
    ;;
  *)
    echo "usage: $0 {install|update|uninstall|install-hook|install-claude-hook|install-codex-hook|uninstall-hook|uninstall-claude-hook|uninstall-codex-hook|resurrect-rewrite|start|stop|restart|status|tail}"
    exit 1
    ;;
esac

}

main "$@"
