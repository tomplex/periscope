#!/bin/sh
# Helper for managing the launchd-managed periscope service. See
# docs/superpowers/specs/2026-05-15-periscope-stability-design.md.
#
# `install` generates the launchd plist from the current checkout — the
# repo path and the `uv` location are resolved at install time, so
# periscope can be cloned anywhere and installed by anyone.

REPO="$(cd "$(dirname "$0")/.." && pwd)"
PLIST_DST="$HOME/Library/LaunchAgents/com.tom.periscope.plist"
LABEL="gui/$(id -u)/com.tom.periscope"
CONFIG_DIR="$HOME/.config/periscope"
LOG="$CONFIG_DIR/periscope-17374.log"
# Where `update` looks for releases. Must match updater.RELEASES_URL.
RELEASES_URL="https://github.com/tomplex/periscope.git"

# Everything is wrapped in main() so `sh` parses the WHOLE file before running
# any of it. `update` rewrites this very script mid-execution via git pull; an
# unwrapped script leaves sh resuming at a byte offset into a file that has
# since changed length.
main() {

# Regenerate the launchd plist from the current checkout. Requires $UV (see
# require_uv, which every caller runs as a precondition). Shared by `install`
# and `update`: the plist embeds repo/uv paths AND tunables that change over
# time (NumberOfFiles was raised 256->1024 after a silent EMFILE wedge), so an
# update that only pulls code leaves those fixes unapplied. launchd caches the
# loaded plist — a rewrite only takes effect after bootout+bootstrap, NOT
# `kickstart -k`, which restarts the job against the already-loaded config.
require_uv() {
  UV="$(command -v uv)" || {
    echo "uv not found on PATH — install it: https://docs.astral.sh/uv/" >&2
    return 1
  }
}

# Newline-separated settings.json paths for every Claude config dir periscope
# launches under: ~/.claude plus each registered account's dir from state.json.
# A state file with no registry yet (periscope never booted since the registry
# moved there) yields ~/.claude alone; boot seeds it. An unreadable state file
# (mid-write, corrupt) must still yield ~/.claude: an empty list makes install
# and uninstall silent no-ops for every account.
account_settings_files() {
    python3 - "$CONFIG_DIR/state.json" <<'PY'
import json, os, sys
dirs = [os.path.expanduser("~/.claude")]
try:
    with open(sys.argv[1]) as f:
        dirs += [a["config_dir"] for a in (json.load(f).get("accounts") or []) if a.get("config_dir")]
except (OSError, ValueError) as e:
    print(f"account registry unreadable ({e}); using ~/.claude only", file=sys.stderr)
print("\n".join(os.path.join(d, "settings.json") for d in dirs))
PY
}

write_plist() {
    mkdir -p "$CONFIG_DIR"
    cat > "$PLIST_DST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tom.periscope</string>
  <key>WorkingDirectory</key>
  <string>$REPO</string>
  <!-- This script, not uv: System Settings > Login Items names a job after
       whoever signed its program, and falls back to the file name for an
       unsigned one. Launching uv directly lists periscope as "OpenAI OpCo,
       LLC" (uv's signer); switching that off stops the server. -->
  <key>ProgramArguments</key>
  <array>
    <string>$REPO/bin/periscope</string>
    <string>serve</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$(dirname "$UV"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>$HOME</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <!-- launchd's default RLIMIT_NOFILE is 256. EMFILE here doesn't crash the
       process (KeepAlive can't recycle it) — it wedges, 500ing forever. Give
       headroom well above legit usage (~1 fd/pane); the worker tick warns long
       before this if fds actually run away. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>1024</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$CONFIG_DIR/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>$CONFIG_DIR/launchd-stderr.log</string>
</dict>
</plist>
EOF
}

case "$1" in
  install)
    command -v npm >/dev/null 2>&1 || {
      echo "npm not found on PATH — install Node.js: https://nodejs.org/" >&2
      exit 1
    }
    # The frontend is a committed Vite bundle (static/dist/app.js). Build it
    # at install time so the launchd-managed server has a fresh artifact.
    ( cd "$REPO" && npm install && npm run build ) || {
      echo "npm install && npm run build failed" >&2
      exit 1
    }
    require_uv || exit 1
    write_plist || exit 1
    launchctl bootstrap "gui/$(id -u)" "$PLIST_DST"
    "$0" install-hook
    "$0" install-skill
    "$0" install-tmux
    ;;
  update)
    # Pull + re-provision + restart. Ordering is the safety property: the git
    # pull happens BEFORE anything touches launchd, so the common failures
    # (dirty tree, diverged branch) abort with the running server completely
    # untouched — and, when driven from POST /api/update, still alive to serve
    # the error back to the dashboard.
    #
    # Deliberately does NOT run `npm run build`: static/dist/app.js is
    # committed, so the pull already carries it, and a build against drifted
    # node_modules can emit a different bundle — dirtying the tree and breaking
    # the NEXT fast-forward.
    # `uv` is a precondition of write_plist, so resolve it BEFORE the pull. A
    # pull that lands and then aborts at write_plist leaves the new committed
    # bundle (served per-request from disk) talking to the old Python — a
    # silent, permanent version skew.
    require_uv || exit 1
    # Refuse from a linked worktree. $REPO comes from dirname "$0", so running
    # this from .claude/worktrees/foo would pull the FEATURE branch and then
    # write WorkingDirectory=<worktree> into the PROD plist — leaving prod
    # pointing at a directory that ExitWorktree later deletes.
    if [ "$(git -C "$REPO" rev-parse --git-dir)" != "$(git -C "$REPO" rev-parse --git-common-dir)" ]; then
      echo "refusing: $REPO is a linked worktree — update the main checkout instead" >&2
      exit 1
    fi
    # Never block on a credential or host-key prompt: under launchd there is no
    # tty to answer one, and a wedged `git pull` would pin updater.running()
    # true forever, 409ing every later attempt until the server restarts.
    GIT_TERMINAL_PROMPT=0; export GIT_TERMINAL_PROMPT
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -oBatchMode=yes}"; export GIT_SSH_COMMAND
    OLD="$(git -C "$REPO" rev-parse --short HEAD)"
    # Refresh first: a stale index makes diff-index report phantom modifications
    # from mtime churn alone.
    git -C "$REPO" update-index -q --refresh
    git -C "$REPO" diff-index --quiet HEAD -- || {
      echo "working tree is dirty — commit or stash before updating" >&2
      exit 1
    }
    # The target is the newest release tag, never main's tip — see
    # docs/updating.md > "What an update targets". Tags come straight from the
    # canonical repo rather than whatever remote `main` tracks: a contributor's
    # checkout may track a fork whose main sat 898 commits stale.
    #
    # NOT `git pull --ff-only`: on git 2.33 that dies "Not possible to
    # fast-forward, aborting." whenever the checkout is merely AHEAD, even with
    # nothing to fetch. fetch + `merge --ff-only` answers all three cases
    # correctly — no-op when ahead only (a checkout past the newest release),
    # fast-forward when behind, refuse on GENUINE divergence, which is the
    # ordering guarantee that keeps launchd untouched on failure.
    git -C "$REPO" fetch --quiet "$RELEASES_URL" '+refs/tags/v*:refs/tags/v*' || {
      echo "git fetch failed — can't reach $RELEASES_URL" >&2
      exit 1
    }
    TARGET="$(git -C "$REPO" tag --list 'v*' --sort=-v:refname | head -1)"
    [ -n "$TARGET" ] || {
      echo "no release to update to — nothing tagged at $RELEASES_URL" >&2
      exit 1
    }
    git -C "$REPO" merge --ff-only "$TARGET" || {
      echo "fast-forward to $TARGET failed — this checkout has commits that aren't in it" >&2
      exit 1
    }
    NEW="$(git -C "$REPO" rev-parse --short HEAD)"
    write_plist || exit 1
    # Validate before booting out: a malformed plist is the one realistic way
    # bootstrap fails, and past this line a failure means nothing is running.
    plutil -lint "$PLIST_DST" >/dev/null 2>&1 || {
      echo "generated plist is malformed — refusing to restart" >&2
      exit 1
    }
    # bootout is ASYNCHRONOUS and periscope has twice lingered in teardown (once
    # 20s, once 3+ min — see CLAUDE.md > Development workflow). Bootstrapping
    # into a half-torn-down job fails, and by then we are already booted out
    # with KeepAlive unable to help: the dashboard is gone, so nothing can even
    # report the failure. Wait for the job to actually leave, then retry.
    launchctl bootout "$LABEL" 2>/dev/null
    i=0
    while [ "$i" -lt 60 ]; do
      launchctl print "$LABEL" >/dev/null 2>&1 || break
      i=$((i + 1))
      sleep 1
    done
    i=0
    until launchctl bootstrap "gui/$(id -u)" "$PLIST_DST" 2>/dev/null; do
      i=$((i + 1))
      if [ "$i" -ge 15 ]; then
        echo "launchctl bootstrap failed after $i tries — periscope is NOT running." >&2
        echo "recover with: $0 start" >&2
        exit 1
      fi
      sleep 2
    done
    "$0" install-hook
    "$0" install-skill
    "$0" install-tmux
    # Verify the new code is actually serving rather than claiming success:
    # poll healthz until it reports the SHA we just pulled. Generous, because
    # a pull that changed server.py's PEP-723 header makes `uv run` resolve and
    # download dependencies before the port ever opens.
    i=0
    while [ "$i" -lt 180 ]; do
      SERVING="$(curl -fsS "http://127.0.0.1:17374/api/healthz" 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null)"
      if [ "$SERVING" = "$NEW" ]; then
        echo "updated $OLD -> $NEW"
        exit 0
      fi
      # healthz reports 'unknown' when git isn't on the launchd PATH. The SHA
      # can then never match, so waiting out the full timeout would report a
      # failure for an update that actually landed.
      if [ "$SERVING" = "unknown" ]; then
        echo "updated $OLD -> $NEW (serving, but healthz can't read its own SHA)"
        exit 0
      fi
      i=$((i + 1))
      sleep 1
    done
    echo "timed out waiting for periscope to serve $NEW (last saw '$SERVING')" >&2
    exit 1
    ;;
  uninstall)
    launchctl bootout "$LABEL" 2>/dev/null
    rm -f "$PLIST_DST"
    "$0" uninstall-hook
    "$0" uninstall-skill
    "$0" uninstall-tmux
    ;;
  install-hook)
    "$0" install-claude-hook
    "$0" install-codex-hook
    ;;
  install-claude-hook)
    # Register pane_session_hook.py on Claude's SessionStart + UserPromptSubmit
    # hooks so each pane records its CURRENT session id (periscope.turns maps
    # pane -> session). SessionStart fires at startup AND on /clear (immediate,
    # before the first prompt — a fresh pane shows its OWN transcript at once);
    # UserPromptSubmit catches every prompt (migrates pre-hook panes on next
    # message). PermissionRequest runs pane_permission_hook.py on every
    # permission dialog (no matcher: every tool) so a native banner can offer
    # Allow / Deny for exactly that request; it prints nothing, since JSON
    # output would answer the dialog. SessionEnd runs the history indexer
    # (`history/`) so the finished transcript is summarized into
    # ~/.claude/history.db — without it the /history search UI has nothing
    # behind it. Idempotent merge — joins an existing matcher-less hook group,
    # preserves everything else.
    #
    # Runs for EVERY account config dir, not just ~/.claude. Claude reads hooks
    # from whichever CLAUDE_CONFIG_DIR it was launched under, so a second-account
    # pane whose settings.json lacks these writes no pane_sessions row — and the
    # transcript view, the narrator (which has no cwd fallback by design),
    # per-pane burn, and resurrect's --resume rewrite all go dark for it, with no
    # error anywhere. The dirs are the account registry in prod's state.json
    # (store.get_accounts); ones that don't exist on this machine are skipped.
    python3 - "$REPO" "$(account_settings_files)" <<'PY'
import json, os, shlex, sys
repo = sys.argv[1]
# `|| true`: these two are pure observers (no matcher — every tool), so a
# missing file must still exit 0. Claude treats a nonzero UserPromptSubmit as
# BLOCKING the prompt, and this install can repoint pane_session_hook.py's
# entry too (see _target_missing below) — if that ever leaves a dangling path
# for a moment, every prompt in every pane must still get through.
pane_cmd = f"python3 {shlex.quote(os.path.join(repo, 'pane_session_hook.py'))} || true"
# -I -S: isolated, no site/sitecustomize — stdlib only, so this still runs
# under a bare /usr/bin/python3 with no venv or PYTHONPATH poisoning it.
perm_cmd = f"python3 -I -S {shlex.quote(os.path.join(repo, 'pane_permission_hook.py'))} || true"
# `cd` + `uv run`: Claude fires hooks from the pane's cwd, and `-m history`
# only resolves from the checkout with its venv.
hist_cmd = f"cd {shlex.quote(repo)} && uv run python -m history hook"
wanted = (
    ("SessionStart", pane_cmd, "pane_session_hook.py", 5),
    ("UserPromptSubmit", pane_cmd, "pane_session_hook.py", 5),
    ("PermissionRequest", perm_cmd, "pane_permission_hook.py", 5),
    ("SessionEnd", hist_cmd, "-m history hook", 120),
)

def _target_path(command):
    # The .py file (or, for the history hook, the `cd` dir) this command
    # points at, or None if the command doesn't parse or match that shape.
    try:
        toks = shlex.split(command)
    except ValueError:
        return None
    for i, t in enumerate(toks):
        if t.endswith(".py"):
            return t
        if t == "cd" and i + 1 < len(toks):
            return toks[i + 1]
    return None

def _target_missing(command):
    # Whether the entry we're about to repoint is actually dead. Without
    # this, installing from a worktree would rewrite prod's (or another
    # worktree's) still-live entry to point in here — then removing this
    # worktree leaves `python3 <gone>.py` behind, which exits 2, which Claude
    # reads as BLOCKING every prompt until someone reinstalls from main.
    path = _target_path(command)
    if path is None:
        return False
    return not os.path.exists(path)

def _same_target(old_command, new_command):
    # Whether an existing entry already points at THIS checkout (just in an
    # older form — missing -I -S, missing `|| true`). Safe to rewrite in
    # place: it isn't another live checkout's entry, it's ours, stale only in
    # its flags.
    old_path, new_path = _target_path(old_command), _target_path(new_command)
    if old_path is None or new_path is None:
        return False
    return os.path.realpath(old_path) == os.path.realpath(new_path)

for p in sys.argv[2].splitlines():
    if not os.path.isdir(os.path.dirname(p)):
        continue          # that account isn't set up on this machine
    try:
        with open(p) as f: d = json.load(f)
    except FileNotFoundError:
        d = {}
    hooks = d.setdefault("hooks", {})
    added = []
    for ev, cmd, marker, timeout in wanted:
        groups = hooks.setdefault(ev, [])
        existing = next((h for g in groups for h in g.get("hooks", [])
                          if marker in h.get("command", "")), None)
        if existing is not None:
            # Repoint when the CURRENT target is gone, OR it's already THIS
            # checkout in an older form (missing -I -S / `|| true`) — never
            # just because this install's own path differs from a DIFFERENT
            # live checkout's (prod's, or another worktree's).
            old_cmd = existing.get("command", "")
            if old_cmd != cmd and (_target_missing(old_cmd) or _same_target(old_cmd, cmd)):
                existing["command"] = cmd
                existing["timeout"] = timeout
                added.append(ev)
            continue
        entry = {"type": "command", "command": cmd, "timeout": timeout}
        # Join only a matcher-less group: None, "" and "*" all mean "every
        # tool" — a scoped one (a user's "Bash" PermissionRequest group, say)
        # would silently narrow ours.
        open_group = next((g for g in groups if g.get("matcher") in (None, "", "*")), None)
        if open_group is not None:
            open_group.setdefault("hooks", []).append(entry)
        else:
            groups.append({"matcher": "", "hooks": [entry]})
        added.append(ev)
    if added:
        with open(p, "w") as f: json.dump(d, f, indent=2)
        print(f"installed periscope hooks in {p} on: {', '.join(added)}")
    else:
        print(f"periscope hooks already installed in {p}")
PY
    ;;
  install-codex-hook)
    ( cd "$REPO" && exec python3 -m periscope.codex_hook_config install "$REPO" )
    ;;
  uninstall-hook)
    "$0" uninstall-claude-hook
    "$0" uninstall-codex-hook
    ;;
  uninstall-claude-hook)
    # Mirrors install-claude-hook: every account config dir, not just ~/.claude,
    # or uninstall leaves the second account's panes still firing the hook.
    python3 - "$(account_settings_files)" <<'PY'
import json, os, sys
for p in sys.argv[1].splitlines():
    try:
        with open(p) as f: d = json.load(f)
    except FileNotFoundError:
        continue
    h = d.get("hooks", {})
    for ev in ("SessionStart", "UserPromptSubmit", "PermissionRequest", "SessionEnd"):
        groups = h.get(ev, [])
        for g in groups:
            g["hooks"] = [x for x in g.get("hooks", [])
                          if "pane_session_hook.py" not in x.get("command", "")
                          and "pane_permission_hook.py" not in x.get("command", "")
                          and "-m history hook" not in x.get("command", "")]
        groups = [g for g in groups if g.get("hooks")]
        if groups:
            h[ev] = groups
        else:
            h.pop(ev, None)
    with open(p, "w") as f: json.dump(d, f, indent=2)
    print(f"removed periscope hooks from {p}")
PY
    ;;
  uninstall-codex-hook)
    ( cd "$REPO" && exec python3 -m periscope.codex_hook_config uninstall "$REPO" )
    ;;
  install-skill)
    # Symlink each vendored skill (skills/<name>) into <config_dir>/skills for
    # every account config dir, same set as install-claude-hook. The reviews
    # prepare action spawns a Claude with "Run the `walkthrough` skill …" — on
    # a config dir without the skill that Claude has nothing to run and the
    # button silently does nothing. A symlink, not a copy, so a pull updates
    # the skill in step with the parser that reads its output (reviews.py).
    #
    # Repoint an existing link only when its target is gone or already this
    # checkout: installing from a worktree must not steal prod's live link,
    # or removing the worktree leaves it dangling (same rule as the hooks).
    # A real directory is the user's own copy — left alone, reported.
    python3 - "$REPO" "$(account_settings_files)" <<'PY'
import os, sys
repo = sys.argv[1]
names = sorted(os.listdir(os.path.join(repo, "skills")))
for p in sys.argv[2].splitlines():
    cfg = os.path.dirname(p)
    if not os.path.isdir(cfg):
        continue          # that account isn't set up on this machine
    skills = os.path.join(cfg, "skills")
    os.makedirs(skills, exist_ok=True)
    done, kept = [], []
    for name in names:
        src = os.path.join(repo, "skills", name)
        dst = os.path.join(skills, name)
        if os.path.islink(dst):
            if os.path.realpath(dst) == os.path.realpath(src):
                continue
            if os.path.exists(dst):
                kept.append(f"{name} -> {os.readlink(dst)}")
                continue
            os.unlink(dst)
        elif os.path.exists(dst):
            kept.append(f"{name} (a directory, not a link)")
            continue
        os.symlink(src, dst)
        done.append(name)
    if done:
        print(f"linked skills into {skills}: {', '.join(done)}")
    else:
        print(f"periscope skills already linked in {skills}")
    for k in kept:
        print(f"  left alone: {k}", file=sys.stderr)
PY
    ;;
  uninstall-skill)
    # Remove only links that point into THIS checkout; another checkout's
    # live link, or the user's own directory, stays.
    python3 - "$REPO" "$(account_settings_files)" <<'PY'
import os, sys
repo = sys.argv[1]
for p in sys.argv[2].splitlines():
    skills = os.path.join(os.path.dirname(p), "skills")
    for name in os.listdir(os.path.join(repo, "skills")):
        dst = os.path.join(skills, name)
        if os.path.islink(dst) and os.path.realpath(dst) == os.path.realpath(os.path.join(repo, "skills", name)):
            os.unlink(dst)
            print(f"removed {dst}")
PY
    ;;
  install-tmux)
    # The tmux side of continuation-over-reboot: TPM + tmux-resurrect +
    # tmux-continuum, plus a periscope-owned conf sourced from the user conf
    # TPM reads (the XDG one when it exists, else ~/.tmux.conf) that points
    # @resurrect-hook-post-save-layout at THIS checkout. Fails loudly (exit 1)
    # on a missing plugin, or when tmux would not run TPM exactly once — a
    # silently missing plugin is a silently missing save.
    ( cd "$REPO" && exec python3 -m periscope.tmux_persist install "$REPO" )
    ;;
  uninstall-tmux)
    ( cd "$REPO" && exec python3 -m periscope.tmux_persist uninstall )
    ;;
  resurrect-rewrite)
    # tmux-resurrect post-save-layout hook (save.sh passes the save-file path).
    # Rewrites claude pane commands to `claude --resume <uuid> <channels>` so a
    # reboot restores each pane's specific session instead of a fresh one. Run
    # from the checkout so `periscope` is importable (tmux fires hooks from an
    # arbitrary cwd); stdlib-only, so plain python3 with no uv/venv.
    ( cd "$REPO" && exec python3 -m periscope.resurrect "$2" )
    ;;
  serve)
    # What launchd runs (see write_plist for why it is this script). exec, so
    # the job's process is uv itself: no sh left in between to swallow signals.
    cd "$REPO" && exec uv run server.py
    ;;
  start)
    launchctl bootstrap "gui/$(id -u)" "$PLIST_DST"
    ;;
  stop)
    launchctl bootout "$LABEL"
    ;;
  restart)
    launchctl kickstart -k "$LABEL"
    ;;
  status)
    launchctl print "$LABEL" 2>/dev/null | grep -E 'state|pid' || echo "not loaded"
    ;;
  tail)
    tail -F "$LOG"
    ;;
  *)
    echo "usage: $0 {install|update|uninstall|install-hook|install-claude-hook|install-codex-hook|uninstall-hook|uninstall-claude-hook|uninstall-codex-hook|install-tmux|uninstall-tmux|resurrect-rewrite|serve|start|stop|restart|status|tail}"
    exit 1
    ;;
esac

}

main "$@"
