{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Periscope",
  "version": "0.1.0",
  "identifier": "com.tom.periscope.app",
  "build": {
    "frontendDist": "../src-tauri/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Periscope",
        "url": "http://127.0.0.1:8765",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Periscope tmux dashboard",
    "longDescription": "Browser-quality dashboard over your tmux panes — native shell."
  }
}
